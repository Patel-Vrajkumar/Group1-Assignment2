@page "/facultypage"
@using WorkloadProject2025.Data
@using WorkloadProject2025.Data.Models
@using Microsoft.EntityFrameworkCore

<PageTitle>Faculty Profile & Workload</PageTitle>

@inject ApplicationDbContext DbContext

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4">Faculty Management</MudText>
    
    <FacultyForm OnSaved="LoadData"></FacultyForm>
    
    @if (facultyList != null)
    {
        <MudDataGrid Items="@facultyList" Filterable="true" Quick Filter="@_quickFilter">
            <Columns>
                <PropertyColumn Property="x => x.Email" Title="Email" />
                <PropertyColumn Property="x => x.FirstName" Title="First Name" />
                <PropertyColumn Property="x => x.LastName" Title="Last Name" />
                <PropertyColumn Property="x => x.PhoneNumber" Title="Phone" />
                <PropertyColumn Property="x => x.EmploymentCategory" Title="Employment Type" />
            </Columns>
        </MudDataGrid>
    }
</MudContainer>

@code {
    private List<Faculty> facultyList = new();
    private Func<Faculty, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;
        if (x.FirstName.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (x.LastName.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (x.Email.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    };
    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        facultyList = await DbContext.Faculty.ToListAsync();
    }
}
