@page "/facultyworkloadpage"
@using WorkloadProject2025.Data
@using WorkloadProject2025.Data.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@using MudBlazor

<PageTitle>Faculty Workload Assignment</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Primary" />
                <div>
                    <MudText Typo="Typo.h4" Class="mb-1">Faculty Workload Assignment</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Assign and track workload for faculty members</MudText>
                </div>
            </MudStack>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Secondary" 
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="OpenCopyDialog">
                    Copy Previous Year
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadData">
                    Refresh
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    <FacultyWorkLoadForm OnSaved="LoadData"></FacultyWorkLoadForm>

    <MudCard Class="mx-auto mt-6" Elevation="4">
        <MudCardHeader Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <CardHeaderContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.h5" Style="color: white; font-weight: 600;">Current Faculty Workloads</MudText>
                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.9);">Total: @workloads.Count assignments • @workloads.Sum(w => w.HoursAssigned) total hours</MudText>
                    </div>
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            @if (workloads.Any())
            {
                <MudGrid Spacing="3">
                    @foreach (var w in workloads.OrderByDescending(x => x.DateAssigned))
                    {
                        var chipColor = GetWorkloadColor(w.HoursAssigned);
                        <MudItem xs="12" md="6" lg="4">
                            <MudCard Elevation="2" Class="workload-card" Style="height: 100%;">
                                <MudCardHeader Style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                                    <CardHeaderContent>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <div>
                                                <MudText Typo="Typo.h6" Style="font-weight: 600;">@w.FacultyEmail</MudText>
                                                <MudChip T="string" Size="Size.Small" Color="chipColor" Icon="@Icons.Material.Filled.Timer" Style="font-weight: 500;">
                                                    @w.HoursAssigned hrs
                                                </MudChip>
                                            </div>
                                        </MudStack>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudStack Spacing="2">
                                        <MudPaper Elevation="0" Class="pa-2" Style="background-color: #f8f9fa; border-left: 4px solid #667eea; border-radius: 4px;">
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: #667eea;">
                                                <MudIcon Icon="@Icons.Material.Filled.Work" Size="Size.Small" /> @w.Workload.ToString().Replace("_", " ")
                                            </MudText>
                                        </MudPaper>
                                        
                                        @if (!string.IsNullOrWhiteSpace(w.Description))
                                        {
                                            <MudText Typo="Typo.body2" Style="color: #666;">
                                                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" /> @w.Description
                                            </MudText>
                                        }
                                        
                                        <MudDivider />
                                        
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Info" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Assigned: @(w.DateAssigned?.ToString("MMM dd, yyyy") ?? "N/A")
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">
                    <MudText Typo="Typo.body1">No workload assignments found. Add a workload assignment using the form above.</MudText>
                </MudAlert>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

<MudDialog @bind-Visible="copyDialogOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Class="mr-1" />
            Copy Previous Year Workloads
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (!showPreview)
            {
                <MudAlert Severity="Severity.Info">
                    Copy workload assignments from a previous term with conflict detection and resolution options.
                </MudAlert>
                
                <MudSelect T="int?"
                           Label="Source Term (Previous Year)"
                           @bind-Value="selectedSourceTermId"
                           Variant="Variant.Outlined"
                           Required="true"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                           HelperText="Select the term to copy from"
                           Disabled="@isCopying">
                    @foreach (var term in availableTerms)
                    {
                        <MudSelectItem Value="@((int?)term.Id)">@term.IntakeName (@term.Year)</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int?"
                           Label="Target Term (New Year)"
                           @bind-Value="selectedTargetTermId"
                           Variant="Variant.Outlined"
                           Required="true"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Event"
                           HelperText="Select the term to copy to"
                           Disabled="@isCopying">
                    @foreach (var term in availableTerms)
                    {
                        <MudSelectItem Value="@((int?)term.Id)">@term.IntakeName (@term.Year)</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="CopyScope"
                           Label="Copy Scope"
                           @bind-Value="copyScope"
                           Variant="Variant.Outlined"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.FilterList"
                           HelperText="Select what to copy"
                           Disabled="@isCopying">
                    <MudSelectItem Value="CopyScope.All">All Workloads</MudSelectItem>
                    <MudSelectItem Value="CopyScope.Instructor">Specific Instructor</MudSelectItem>
                    <MudSelectItem Value="CopyScope.Program">Specific Program</MudSelectItem>
                    <MudSelectItem Value="CopyScope.Department">Specific Department</MudSelectItem>
                </MudSelect>

                @if (copyScope == CopyScope.Instructor)
                {
                    <MudAutocomplete T="Faculty"
                                     Label="Select Instructor"
                                     @bind-Value="selectedInstructor"
                                     SearchFunc="@SearchInstructors"
                                     ToStringFunc="@(f => f != null ? $"{f.FirstName} {f.LastName}" : "")"
                                     Variant="Variant.Outlined"
                                     Disabled="@isCopying">
                        <ItemTemplate Context="faculty">
                            <MudText Typo="Typo.body2">@faculty.FirstName @faculty.LastName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@faculty.Email</MudText>
                        </ItemTemplate>
                    </MudAutocomplete>
                }
                @if (copyScope == CopyScope.Program)
                {
                    <MudSelect T="int?"
                               Label="Select Program"
                               @bind-Value="selectedProgramId"
                               Variant="Variant.Outlined"
                               Disabled="@isCopying">
                        @foreach (var program in programs)
                        {
                            <MudSelectItem Value="@((int?)program.Id)">@program.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                @if (copyScope == CopyScope.Department)
                {
                    <MudSelect T="int?"
                               Label="Select Department"
                               @bind-Value="selectedDepartmentId"
                               Variant="Variant.Outlined"
                               Disabled="@isCopying">
                        @foreach (var dept in departments)
                        {
                            <MudSelectItem Value="@((int?)dept.Id)">@dept.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            }
            else
            {
                <!-- Preview Section -->
                <MudAlert Severity="Severity.Info">
                    Review items to copy and resolve conflicts
                </MudAlert>

                <MudPaper Class="pa-3" Elevation="1">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle2">Summary</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@previewItems.Count items</MudChip>
                    </MudStack>
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.body2">
                        <strong>@conflictItems.Count</strong> conflicts detected
                    </MudText>
                    <MudText Typo="Typo.body2">
                        <strong>@(previewItems.Count - conflictItems.Count)</strong> new assignments
                    </MudText>
                </MudPaper>

                @if (conflictItems.Any())
                {
                    <MudPaper Class="pa-3" Elevation="1" Style="max-height: 300px; overflow-y: auto;">
                        <MudText Typo="Typo.subtitle2" Color="Color.Warning">Conflicts</MudText>
                        @foreach (var item in conflictItems)
                        {
                            <MudPaper Class="pa-2 my-2" Elevation="0" Style="background-color: #fff3cd; border-left: 4px solid #ffc107;">
                                <MudText Typo="Typo.body2">
                                    <strong>@item.FacultyName</strong> → @item.CourseName (@item.Hours hrs)
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Warning">
                                    Already assigned in target term
                                </MudText>
                            </MudPaper>
                        }
                    </MudPaper>

                    <MudRadioGroup T="ConflictResolution" @bind-Value="conflictResolution">
                        <MudRadio Value="ConflictResolution.Skip" Color="Color.Primary">
                            Skip conflicting items
                        </MudRadio>
                        <MudRadio Value="ConflictResolution.Overwrite" Color="Color.Warning">
                            Overwrite existing assignments (⚠️ This will replace existing data)
                        </MudRadio>
                    </MudRadioGroup>
                }
            }
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CloseCopyDialog" Color="Color.Default" Disabled="@isCopying">
                Cancel
            </MudButton>
            @if (!showPreview)
            {
                <MudButton OnClick="PreviewCopy" 
                           Color="Color.Info" 
                           Variant="Variant.Filled" 
                           StartIcon="@Icons.Material.Filled.Preview"
                           Disabled="@(!CanPreview() || isCopying)">
                    Preview
                </MudButton>
            }
            else
            {
                <MudButton OnClick="BackToSelection" 
                           Color="Color.Default" 
                           Variant="Variant.Outlined"
                           Disabled="@isCopying">
                    Back
                </MudButton>
                <MudButton OnClick="ExecuteCopy" 
                           Color="Color.Primary" 
                           Variant="Variant.Filled" 
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           Disabled="@isCopying">
                    @if (isCopying)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        <span>Copying...</span>
                    }
                    else
                    {
                        <span>Copy @(previewItems.Count - (conflictResolution == ConflictResolution.Skip ? conflictItems.Count : 0)) Items</span>
                    }
                </MudButton>
            }
        </DialogActions>
</MudDialog>

<style>
    .workload-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    
    .workload-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15) !important;
    }
</style>

@code {
    private List<FacultyWorkLoad> workloads = new();
    private List<Term> availableTerms = new();
    private List<Faculty> instructors = new();
    private List<ProgramOfStudy> programs = new();
    private List<Department> departments = new();
    
    // Copy dialog state
    private bool copyDialogOpen = false;
    private bool showPreview = false;
    private bool isCopying = false;
    private int? selectedSourceTermId;
    private int? selectedTargetTermId;
    private CopyScope copyScope = CopyScope.All;
    private Faculty? selectedInstructor;
    private int? selectedProgramId;
    private int? selectedDepartmentId;
    private ConflictResolution conflictResolution = ConflictResolution.Skip;
    
    // Preview data
    private List<CopyPreviewItem> previewItems = new();
    private List<CopyPreviewItem> conflictItems = new();
    
    private DialogOptions dialogOptions = new() 
    { 
        MaxWidth = MaxWidth.Medium, 
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        availableTerms = await _context.Terms.OrderByDescending(t => t.StartDate).ToListAsync();
        instructors = await _context.Faculty.OrderBy(f => f.LastName).ToListAsync();
        programs = await _context.ProgramsOfStudy.OrderBy(p => p.Name).ToListAsync();
        departments = await _context.Departments.OrderBy(d => d.Name).ToListAsync();
    }

    private async Task LoadData()
    {
        workloads = await _context.FacultyWorkLoads.ToListAsync();
        StateHasChanged();
    }

    private Color GetWorkloadColor(decimal hours)
    {
        if (hours >= 40) return Color.Error;
        if (hours >= 25) return Color.Warning;
        if (hours >= 10) return Color.Info;
        return Color.Success;
    }

    private void OpenCopyDialog()
    {
        copyDialogOpen = true;
        showPreview = false;
        previewItems.Clear();
        conflictItems.Clear();
        selectedSourceTermId = null;
        selectedTargetTermId = null;
        copyScope = CopyScope.All;
        conflictResolution = ConflictResolution.Skip;
    }

    private void CloseCopyDialog()
    {
        copyDialogOpen = false;
        showPreview = false;
        previewItems.Clear();
        conflictItems.Clear();
    }

    private bool CanPreview()
    {
        if (!selectedSourceTermId.HasValue || !selectedTargetTermId.HasValue)
            return false;
        if (selectedSourceTermId == selectedTargetTermId)
            return false;
        if (copyScope == CopyScope.Instructor && selectedInstructor == null)
            return false;
        if (copyScope == CopyScope.Program && !selectedProgramId.HasValue)
            return false;
        if (copyScope == CopyScope.Department && !selectedDepartmentId.HasValue)
            return false;
        return true;
    }

    private async Task<IEnumerable<Faculty>> SearchInstructors(string searchText, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return instructors.Take(10);
        
        return instructors
            .Where(f => f.FirstName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                       f.LastName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                       f.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .Take(10);
    }

    private async Task PreviewCopy()
    {
        if (!CanPreview())
        {
            Snackbar.Add("Please complete all required selections", Severity.Warning);
            return;
        }

        try
        {
            // Build query based on scope
            var query = _context.FacultyWorkLoads
                .Include(w => w.Faculty)
                .Include(w => w.Course)
                .ThenInclude(c => c!.ProgramOfStudy)
                .Where(w => w.TermId == selectedSourceTermId!.Value);

            switch (copyScope)
            {
                case CopyScope.Instructor:
                    if (selectedInstructor != null)
                        query = query.Where(w => w.FacultyEmail == selectedInstructor.Email);
                    break;
                case CopyScope.Program:
                    if (selectedProgramId.HasValue)
                        query = query.Where(w => w.Course != null && w.Course.ProgramOfStudyId == selectedProgramId.Value);
                    break;
                case CopyScope.Department:
                    if (selectedDepartmentId.HasValue)
                        query = query.Where(w => w.Faculty != null && w.Faculty.DepartmentId == selectedDepartmentId.Value);
                    break;
            }

            var sourceWorkloads = await query.ToListAsync();

            if (!sourceWorkloads.Any())
            {
                Snackbar.Add("No workloads found matching the selected criteria", Severity.Warning);
                return;
            }

            // Build preview items and batch conflict check
            previewItems.Clear();
            conflictItems.Clear();

            // Batch query: Get all existing workloads in target term that might conflict
            var existingWorkloads = await _context.FacultyWorkLoads
                .Where(w => w.TermId == selectedTargetTermId!.Value)
                .Select(w => new { w.FacultyEmail, w.CourseId })
                .ToListAsync();

            // Create a HashSet for O(1) lookup
            var existingCombinations = new HashSet<(string, int?)>(
                existingWorkloads.Select(w => (w.FacultyEmail, w.CourseId))
            );

            foreach (var workload in sourceWorkloads)
            {
                var previewItem = new CopyPreviewItem
                {
                    FacultyEmail = workload.FacultyEmail,
                    FacultyName = workload.Faculty != null ? $"{workload.Faculty.FirstName} {workload.Faculty.LastName}" : workload.FacultyEmail,
                    CourseId = workload.CourseId,
                    CourseName = workload.Course?.Name ?? "N/A",
                    Hours = workload.HoursAssigned,
                    WorkloadType = workload.Workload
                };

                previewItems.Add(previewItem);

                // Check for conflicts using in-memory HashSet
                if (existingCombinations.Contains((workload.FacultyEmail, workload.CourseId)))
                {
                    conflictItems.Add(previewItem);
                }
            }

            showPreview = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating preview: {ex.Message}", Severity.Error);
        }
    }

    private void BackToSelection()
    {
        showPreview = false;
        previewItems.Clear();
        conflictItems.Clear();
    }

    private async Task ExecuteCopy()
    {
        if (!selectedSourceTermId.HasValue || !selectedTargetTermId.HasValue)
        {
            Snackbar.Add("Please select both source and target terms", Severity.Warning);
            return;
        }

        isCopying = true;
        StateHasChanged();

        try
        {
            var startTime = DateTime.Now;
            
            // Build query based on scope
            var query = _context.FacultyWorkLoads
                .Include(w => w.Faculty)
                .Include(w => w.Course)
                .Where(w => w.TermId == selectedSourceTermId.Value);

            switch (copyScope)
            {
                case CopyScope.Instructor:
                    if (selectedInstructor != null)
                        query = query.Where(w => w.FacultyEmail == selectedInstructor.Email);
                    break;
                case CopyScope.Program:
                    if (selectedProgramId.HasValue)
                        query = query.Where(w => w.Course != null && w.Course.ProgramOfStudyId == selectedProgramId.Value);
                    break;
                case CopyScope.Department:
                    if (selectedDepartmentId.HasValue)
                        query = query.Where(w => w.Faculty != null && w.Faculty.DepartmentId == selectedDepartmentId.Value);
                    break;
            }

            var sourceWorkloads = await query.ToListAsync();

            if (!sourceWorkloads.Any())
            {
                Snackbar.Add("No workloads found to copy", Severity.Warning);
                return;
            }

            int copiedCount = 0;
            int skippedCount = 0;
            int overwrittenCount = 0;
            var sourceTerm = await _context.Terms.FindAsync(selectedSourceTermId.Value);
            
            foreach (var workload in sourceWorkloads)
            {
                // Check for conflicts
                var existingWorkload = await _context.FacultyWorkLoads
                    .FirstOrDefaultAsync(w => w.FacultyEmail == workload.FacultyEmail &&
                                             w.CourseId == workload.CourseId &&
                                             w.TermId == selectedTargetTermId.Value);

                if (existingWorkload != null)
                {
                    if (conflictResolution == ConflictResolution.Skip)
                    {
                        skippedCount++;
                        continue;
                    }
                    else // Overwrite
                    {
                        _context.FacultyWorkLoads.Remove(existingWorkload);
                        overwrittenCount++;
                    }
                }

                var newWorkload = new FacultyWorkLoad
                {
                    FacultyEmail = workload.FacultyEmail,
                    CourseId = workload.CourseId,
                    TermId = selectedTargetTermId.Value,
                    WorkloadCategoryId = workload.WorkloadCategoryId,
                    Workload = workload.Workload,
                    HoursAssigned = workload.HoursAssigned,
                    Description = workload.Description,
                    DateAssigned = DateTime.Now,
                    Status = WorkloadStatus.Draft,
                    ClonedFromId = workload.Id,
                    SourceYear = sourceTerm?.Year,
                    CreatedDate = DateTime.Now,
                    // TODO: Replace with authenticated user from ICurrentUserService or AuthenticationStateProvider
                    CreatedBy = "CopyOperation"
                };

                _context.FacultyWorkLoads.Add(newWorkload);
                copiedCount++;
            }

            await _context.SaveChangesAsync();
            
            var elapsed = (DateTime.Now - startTime).TotalSeconds;
            var summary = $"✓ {copiedCount} copied";
            if (skippedCount > 0)
                summary += $" • {skippedCount} skipped";
            if (overwrittenCount > 0)
                summary += $" • {overwrittenCount} overwritten";
            summary += $" ({elapsed:F1}s)";
            
            Snackbar.Add(summary, Severity.Success);
            CloseCopyDialog();
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error copying workloads: {ex.Message}", Severity.Error);
        }
        finally
        {
            isCopying = false;
            StateHasChanged();
        }
    }

    // Enums and DTOs
    private enum CopyScope
    {
        All,
        Instructor,
        Program,
        Department
    }

    private enum ConflictResolution
    {
        Skip,
        Overwrite
    }

    private class CopyPreviewItem
    {
        public string FacultyEmail { get; set; } = string.Empty;
        public string FacultyName { get; set; } = string.Empty;
        public int? CourseId { get; set; }
        public string CourseName { get; set; } = string.Empty;
        public decimal Hours { get; set; }
        public Workload WorkloadType { get; set; }
    }
}
