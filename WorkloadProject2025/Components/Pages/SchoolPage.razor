@inject SchoolService _schoolService;
@page "/schoolpage"

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h5">
                <MudIcon Icon="@Icons.Material.Filled.School" Class="mr-2" /> Schools
            </MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenAddDialog">Add New School</MudButton>
        </MudStack>

        <MudTable Items="schools" Dense="true" Hover="true" Elevation="1">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh Class="text-right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd Class="text-right">
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.Domain"
                        OnClick="() => NavigateToDepartments(context.Id)">Departments</MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                        OnClick="() => DeleteSchool(context.Id)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudStack>
</MudContainer>

<MudDialog @bind-Visible="addDialogOpen">
    <DialogContent>
        <SchoolForm OnSaved="Save" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseAddDialog">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    List<School> schools = new();
    bool addDialogOpen = false;

    protected override async Task OnInitializedAsync()
    {
        schools = await _schoolService.GetAllAsync();
    }

    private async Task Save()
    {
        schools = await _schoolService.GetAllAsync();
        addDialogOpen = false;
        StateHasChanged();
    }

    private void OpenAddDialog() => addDialogOpen = true;
    private void CloseAddDialog() => addDialogOpen = false;

    private async Task DeleteSchool(int id)
    {
        var ok = await _schoolService.DeleteAsync(id);
        if (ok)
        {
            schools = await _schoolService.GetAllAsync();
            StateHasChanged();
        }
    }

    private void NavigateToDepartments(int schoolId)
    {
        // placeholder: navigate to department page filtered by this school if route exists
    }
}
