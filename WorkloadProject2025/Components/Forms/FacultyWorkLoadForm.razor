@page "/facultyworkloadform"
@using WorkloadProject2025.Data
@using WorkloadProject2025.Data.Models
@using MudBlazor
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context
@inject ISnackbar Snackbar

<MudCard Class="mx-auto mt-6" Style="max-width:900px;" Elevation="4">
 <MudCardHeader Style="background: linear-gradient(135deg, #667eea0%, #764ba2100%); margin: -16px -16px16px -16px; padding:24px; border-radius:4px4px00;">
 <CardHeaderContent>
 <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
 <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Size="Size.Large" Style="color: white;" />
 <div>
 <MudText Typo="Typo.h5" Style="color: white; font-weight:600;">Add Faculty Workload</MudText>
 <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.9);">Assign workload to a faculty member</MudText>
 </div>
 </MudStack>
 </CardHeaderContent>
 </MudCardHeader>

 <MudCardContent>
 <MudGrid Spacing="3">
 <MudItem xs="12" sm="6">
 <MudSelect Label="Faculty"
 T="string"
 @bind-Value="selectedFacultyEmail"
 Variant="Variant.Outlined"
 Required="true"
 Clearable="false"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.Person"
 AdornmentColor="Color.Primary">
 @foreach (var f in facultyOptions)
 {
 <MudSelectItem Value="@f.Email">@f.FirstName @f.LastName (@f.EmploymentCategory)</MudSelectItem>
 }
 </MudSelect>
 </MudItem>

 <MudItem xs="12" sm="6">
 <MudSelect Label="Term"
 T="int?"
 @bind-Value="selectedTermId"
 Variant="Variant.Outlined"
 Required="true"
 Clearable="false"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.DateRange"
 AdornmentColor="Color.Primary">
 @foreach (var t in termOptions)
 {
 <MudSelectItem Value="@((int?)t.Id)">@t.IntakeName</MudSelectItem>
 }
 </MudSelect>
 </MudItem>

 <MudItem xs="12" sm="6">
 <MudSelect Label="Program of Study"
 T="int?"
 @bind-Value="facultyWorkLoad.ProgramOfStudyId"
 Variant="Variant.Outlined"
 Clearable="true"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.School"
 AdornmentColor="Color.Primary">
 @foreach (var p in programOptions)
 {
 <MudSelectItem Value="@p.Id">@p.Name</MudSelectItem>
 }
 </MudSelect>
 </MudItem>

 <MudItem xs="12" sm="6">
 <MudSelect Label="Course"
 T="int?"
 @bind-Value="facultyWorkLoad.CourseId"
 Variant="Variant.Outlined"
 Clearable="true"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.MenuBook"
 AdornmentColor="Color.Primary">
 @foreach (var c in courseOptions)
 {
 <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
 }
 </MudSelect>
 </MudItem>

 <MudItem xs="12" sm="6">
 <MudSelect T="Workload"
 Label="Workload Type"
 @bind-Value="facultyWorkLoad.Workload"
 Variant="Variant.Outlined"
 Required="true"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.Category"
 AdornmentColor="Color.Primary">
 @foreach (Workload type in Enum.GetValues(typeof(Workload)))
 {
 <MudSelectItem Value="@type">@type.ToString().Replace("_", " ")</MudSelectItem>
 }
 </MudSelect>
 </MudItem>

 <MudItem xs="12" sm="6">
 <MudNumericField T="decimal"
 Label="Hours Assigned"
 @bind-Value="facultyWorkLoad.HoursAssigned"
 Variant="Variant.Outlined"
 Required="true"
 Min="0"
 Max="168"
 Adornment="Adornment.End"
 AdornmentIcon="@Icons.Material.Filled.Timer"
 AdornmentColor="Color.Primary" />
 </MudItem>

 <MudItem xs="12" sm="6">
 <MudSelect Label="Workload Category"
 T="int?"
 @bind-Value="facultyWorkLoad.WorkloadCategoryId"
 Variant="Variant.Outlined"
 Clearable="true"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.Folder"
 AdornmentColor="Color.Primary">
 @foreach (var cat in categoryOptions)
 {
 <MudSelectItem Value="@cat.Id">@cat.Name (@cat.MiniumHours-@cat.MaximumHours)</MudSelectItem>
 }
 </MudSelect>
 </MudItem>

 <MudItem xs="12" sm="6">
 <MudSwitch T="bool" @bind-Checked="facultyWorkLoad.IsPrimaryInstructor" Color="Color.Info" Label="Primary Instructor" />
 </MudItem>

 <MudItem xs="12" sm="6">
 <MudNumericField T="decimal?" Label="Percent Share" @bind-Value="facultyWorkLoad.PercentShare" Min="0" Max="100" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="%" />
 </MudItem>

 <MudItem xs="12">
 <MudTextField Label="Description"
 @bind-Value="facultyWorkLoad.Description"
 Variant="Variant.Outlined"
 Lines="2"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.Description"
 AdornmentColor="Color.Primary" />
 </MudItem>

 <MudItem xs="12">
 <MudTextField Label="Notes"
 @bind-Value="facultyWorkLoad.Notes"
 Variant="Variant.Outlined"
 Lines="3"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.Notes"
 AdornmentColor="Color.Primary" />
 </MudItem>

 <MudItem xs="12" sm="6">
 <MudDatePicker Label="Date Assigned"
 @bind-Date="facultyWorkLoad.DateAssigned"
 Variant="Variant.Outlined"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.CalendarToday"
 AdornmentColor="Color.Primary" />
 </MudItem>

 <MudItem xs="12" sm="6">
 <MudSwitch T="bool" @bind-Checked="facultyWorkLoad.IsCoverage" Color="Color.Warning" Label="Coverage (covering another instructor)" />
 </MudItem>

 @if (facultyWorkLoad.IsCoverage)
 {
 <MudItem xs="12" sm="6">
 <MudTextField Label="Covered For (Instructor Email)"
 @bind-Value="facultyWorkLoad.CoveredForFacultyEmail"
 Variant="Variant.Outlined"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.Email"
 AdornmentColor="Color.Warning" />
 </MudItem>
 }

 <MudItem xs="12">
 <MudDivider Class="my-2" />
 <MudText Typo="Typo.subtitle2" Color="Color.Secondary">HR Processing</MudText>
 </MudItem>

 <MudItem xs="12" sm="4">
 <MudSwitch T="bool" @bind-Checked="facultyWorkLoad.HRProcessed" Color="Color.Success" Label="HR Processed" />
 </MudItem>
 <MudItem xs="12" sm="4">
 <MudDatePicker Label="HR Processed Date"
 @bind-Date="facultyWorkLoad.HRProcessedDate"
 Disabled="@(!facultyWorkLoad.HRProcessed)"
 Variant="Variant.Outlined"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.EventAvailable"
 AdornmentColor="Color.Success" />
 </MudItem>
 <MudItem xs="12" sm="4">
 <MudTextField Label="HR Notes"
 @bind-Value="facultyWorkLoad.HRNotes"
 Variant="Variant.Outlined"
 Lines="2"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.StickyNote2"
 AdornmentColor="Color.Success" />
 </MudItem>

 </MudGrid>
 </MudCardContent>

 <MudCardActions Class="d-flex justify-end pa-4" Style="background-color: #f5f5f5; margin:16px -16px -16px -16px; border-radius:004px4px;">
 <MudButton Variant="Variant.Outlined" 
 Color="Color.Secondary" 
 StartIcon="@Icons.Material.Filled.Close"
 Class="mr-2"
 OnClick="Cancel">
 Cancel
 </MudButton>
 <MudButton Color="Color.Primary" 
 Variant="Variant.Filled" 
 StartIcon="@Icons.Material.Filled.Save"
 Disabled="@(!IsFormValid())"
 OnClick="Save">
 Save Workload
 </MudButton>
 </MudCardActions>
</MudCard>

@code {
 [Parameter] public EventCallback OnSaved { get; set; }

 private FacultyWorkLoad facultyWorkLoad = new()
 {
 DateAssigned = DateTime.Now
 };

 private string? selectedFacultyEmail;
 private int? selectedTermId;

 private List<Faculty> facultyOptions = new();
 private List<Term> termOptions = new();
 private List<Course> courseOptions = new();
 private List<ProgramOfStudy> programOptions = new();
 private List<WorkloadCategory> categoryOptions = new();

 protected override async Task OnInitializedAsync()
 {
 facultyOptions = await _context.Faculty.OrderBy(f => f.LastName).ThenBy(f => f.FirstName).ToListAsync();
 termOptions = await _context.Terms.OrderByDescending(t => t.StartDate).ToListAsync();
 programOptions = await _context.ProgramsOfStudy.OrderBy(p => p.Name).ToListAsync();
 courseOptions = await _context.Courses.OrderBy(c => c.Name).ToListAsync();
 categoryOptions = await _context.WorkloadCategories.OrderBy(c => c.Name).ToListAsync();
 }

 private void Cancel()
 {
 facultyWorkLoad = new FacultyWorkLoad { DateAssigned = DateTime.Now };
 selectedFacultyEmail = null;
 selectedTermId = null;
 }

 private bool IsValidEmail(string email)
 {
 if (string.IsNullOrWhiteSpace(email))
 return false;
 
 try
 {
 var addr = new System.Net.Mail.MailAddress(email);
 return addr.Address == email;
 }
 catch
 {
 return false;
 }
 }

 private bool IsFormValid()
 {
 var valid = !string.IsNullOrWhiteSpace(selectedFacultyEmail) &&
 IsValidEmail(selectedFacultyEmail) &&
 selectedTermId.HasValue &&
 selectedTermId.Value > 0 &&
 facultyWorkLoad.HoursAssigned > 0;
 if (facultyWorkLoad.IsCoverage && !string.IsNullOrWhiteSpace(facultyWorkLoad.CoveredForFacultyEmail))
 {
 valid = valid && IsValidEmail(facultyWorkLoad.CoveredForFacultyEmail);
 }
 return valid;
 }

 private async Task Save()
 {
 if (!IsFormValid())
 {
 Snackbar.Add("Please fill in all required fields correctly.", Severity.Warning);
 return;
 }

 try
 {
 // Assign selected values to the model
 facultyWorkLoad.FacultyEmail = selectedFacultyEmail!;
 facultyWorkLoad.TermId = selectedTermId!.Value;

 if (facultyWorkLoad.HRProcessed && facultyWorkLoad.HRProcessedDate == null)
 {
 facultyWorkLoad.HRProcessedDate = DateTime.Now;
 }
 _context.FacultyWorkLoads.Add(facultyWorkLoad);
 await _context.SaveChangesAsync();

 Snackbar.Add($"Workload assignment of {facultyWorkLoad.HoursAssigned} hours added successfully!", Severity.Success);
 await OnSaved.InvokeAsync();
 Cancel();
 }
 catch (Exception ex)
 {
 Snackbar.Add($"Error adding workload: {ex.Message}", Severity.Error);
 }
 }
}
