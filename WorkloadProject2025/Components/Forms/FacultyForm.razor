@using WorkloadProject2025.Data.Models
@inject FacultyService facultyService
@inject ISnackbar Snackbar

<MudCard Class="mx-auto mt-6 pa-4" Style="max-width:750px;" Elevation="4">
 <MudCardHeader Style="background: linear-gradient(135deg, #667eea0%, #764ba2100%); margin: -16px -16px16px -16px; padding:24px; border-radius:4px4px00;">
 <CardHeaderContent>
 <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
 <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Style="color: white;" />
 <div>
 <MudText Typo="Typo.h5" Style="color: white; font-weight:600;">Add New Faculty Member</MudText>
 <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.9);">Fill in the details below to add a new faculty member</MudText>
 </div>
 </MudStack>
 </CardHeaderContent>
 </MudCardHeader>

 <MudCardContent>
 <MudGrid Spacing="3">
 <MudItem xs="12" sm="6">
 <MudTextField @bind-Value="faculty.FirstName"
 Label="First Name"
 Variant="Variant.Outlined"
 Required="true"
 Immediate="true"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.Person"
 AdornmentColor="Color.Primary"
 HelperText="Enter faculty first name">
 </MudTextField>
 </MudItem>
 <MudItem xs="12" sm="6">
 <MudTextField @bind-Value="faculty.LastName"
 Label="Last Name"
 Variant="Variant.Outlined"
 Required="true"
 Immediate="true"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.Person"
 AdornmentColor="Color.Primary"
 HelperText="Enter faculty last name">
 </MudTextField>
 </MudItem>
 <MudItem xs="12">
 <MudTextField @bind-Value="faculty.Email"
 Label="Email Address"
 Variant="Variant.Outlined"
 Required="true"
 Immediate="true"
 InputType="InputType.Email"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.Email"
 AdornmentColor="Color.Primary"
 HelperText="Enter a valid email address (this will be the unique identifier)">
 </MudTextField>
 </MudItem>
 <MudItem xs="12" sm="6">
 <MudTextField @bind-Value="faculty.PhoneNumber"
 Label="Phone Number"
 Variant="Variant.Outlined"
 Required="true"
 Immediate="true"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.Phone"
 AdornmentColor="Color.Primary"
 HelperText="Enter contact phone number">
 </MudTextField>
 </MudItem>
 <MudItem xs="12" sm="6">
 <MudSelect T="EmploymentType"
 Label="Employment Type"
 @bind-Value="faculty.EmploymentCategory"
 Variant="Variant.Outlined"
 Required="true"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.Badge"
 AdornmentColor="Color.Primary"
 HelperText="Select employment category">
 @foreach (EmploymentType t in Enum.GetValues(typeof(EmploymentType)))
 {
 <MudSelectItem Value="@t">@t.ToString()</MudSelectItem>
 }
 </MudSelect>
 </MudItem>
 <MudItem xs="12">
 <MudTextField @bind-Value="faculty.Notes"
 Label="Notes"
 Variant="Variant.Outlined"
 Lines="4"
 Adornment="Adornment.Start"
 AdornmentIcon="@Icons.Material.Filled.NoteAlt"
 AdornmentColor="Color.Primary"
 HelperText="Optional: sabbaticals, preferences, constraints">
 </MudTextField>
 </MudItem>
 </MudGrid>
 </MudCardContent>

 <MudCardActions Class="d-flex justify-end pa-4" Style="background-color: #f5f5f5; margin:16px -16px -16px -16px; border-radius:004px4px;">
 <MudButton Variant="Variant.Outlined"
 Color="Color.Secondary"
 StartIcon="@Icons.Material.Filled.Close"
 Class="mr-2"
 OnClick="Cancel">
 Cancel
 </MudButton>
 <MudButton Variant="Variant.Filled"
 Color="Color.Primary"
 StartIcon="@Icons.Material.Filled.Save"
 Disabled="@(!IsFormValid())"
 OnClick="Save">
 Add Faculty
 </MudButton>
 </MudCardActions>
</MudCard>

@code {
 [Parameter]
 public EventCallback OnSaved { get; set; }
 
 private Faculty faculty { get; set; } = new Faculty();

 private void Cancel()
 {
 faculty = new Faculty();
 }

 private bool IsValidEmail(string email)
 {
 if (string.IsNullOrWhiteSpace(email))
 return false;
 
 try
 {
 var addr = new System.Net.Mail.MailAddress(email);
 return addr.Address == email;
 }
 catch
 {
 return false;
 }
 }

 private bool IsFormValid()
 {
 return !string.IsNullOrWhiteSpace(faculty.FirstName) &&
 !string.IsNullOrWhiteSpace(faculty.LastName) &&
 !string.IsNullOrWhiteSpace(faculty.Email) &&
 !string.IsNullOrWhiteSpace(faculty.PhoneNumber) &&
 IsValidEmail(faculty.Email);
 }

 private async Task Save()
 {
 if (!IsFormValid())
 {
 Snackbar.Add("Please fill in all required fields correctly.", Severity.Warning);
 return;
 }

 try
 {
 await facultyService.AddAsync(faculty);
 Snackbar.Add($"Faculty member {faculty.FirstName} {faculty.LastName} added successfully!", Severity.Success);
 Console.WriteLine($"Saving Faculty: {faculty.Email}");
 Cancel();
 await OnSaved.InvokeAsync();
 }
 catch (Exception ex)
 {
 Snackbar.Add($"Error adding faculty member: {ex.Message}", Severity.Error);
 }
 }

}
